# ========================================================
# TETAPAN SISTEM PENGURUSAN LEAD & AI WHATSAPP (RUMAH LELONG)
# ========================================================

# Port Pelayan Tempatan
PORT=3000

# Kunci API Google Gemini (Dapatkan secara percuma di https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Google Apps Script Web App URL (URL Selepas Deploy Web App dari Google Sheet)
# Format: https://script.google.com/macros/s/AKfycbx.../exec
GOOGLE_SCRIPT_URL=https://script.google.com/macros/s/AKfycb.../exec

# Kunci Lesen Ejen (Disahkan secara awan menggunakan Machine ID komputer)
LICENSE_KEY=LELONG-PRO-DEMO-2026

# Tetapan Keselamatan WhatsApp Anti-Spam
MIN_DELAY_SECONDS=15
MAX_DELAY_SECONDS=35
DAILY_MESSAGE_LIMIT=80

# Nama Ejen / Agensi untuk Persona AI
AGENT_NAME=Farhan Hakimi
AGENCY_NAME=Hartanah Lelong Specialist Malaysia
